# Copy to .env and fill in. All configuration is environment-only, and none of
# it is required: with no .env at all paperjam starts, generates its secret key
# into the data directory, and asks for the first account on the web page.
# Every PAPERJAM_* variable is documented in docs/configuration.md.

# Optional: your own secret key, at least 32 random bytes (`openssl rand -base64 48`).
# Signs session cookies, OAuth access tokens and links. Unset, a random key is
# kept in the data directory (secret.key) and travels with `paperjam backup`.
# PAPERJAM_SECRET_KEY=

# Optional: create the first administrator at start-up instead of on the web
# page (for scripts and app stores). Both or neither; remove them afterwards.
# PAPERJAM_ADMIN_USER=
# PAPERJAM_ADMIN_PASSWORD=

# Read by compose.example.yml, not by paperjam: where the port is published
# (0.0.0.0 opens it to your network), and the domain and profile of the
# bundled HTTPS proxy.
# PAPERJAM_LISTEN=127.0.0.1
# PAPERJAM_DOMAIN=
# COMPOSE_PROFILES=https

# Where the database, originals, derived files and the search index live.
# PAPERJAM_DATA_DIR=/data
# PAPERJAM_BIND=127.0.0.1:8140
# Public https URL; required for OAuth metadata behind a reverse proxy and for
# passkey sign-in (its host is the WebAuthn relying party).
# PAPERJAM_PUBLIC_URL=
# Log lines on stderr: `text` (default) or `json`; RUST_LOG sets the level.
# PAPERJAM_LOG_FORMAT=text

# Local OCR.
# Tesseract languages of your documents, e.g. eng+deu. Also picks the search
# stemmers. The image ships eng, deu, fra, spa, ita, por, pol, ell,
# ara, rus, ukr, ron; see docs/configuration.md for others.
# PAPERJAM_OCR_LANGS=eng
# PAPERJAM_OCR_WORKERS=1

# Optional LLM layer. Without a key only local recognition runs. OpenRouter is
# the default; any OpenAI-compatible endpoint works (see docs/configuration.md).
# The older names PAPERJAM_OPENROUTER_API_KEY / _BASE_URL still work.
# PAPERJAM_LLM_API_KEY=
# API root of the chat-completions endpoint; the default is OpenRouter itself.
# PAPERJAM_LLM_BASE_URL=https://openrouter.ai/api/v1
# Dialect: auto (by host; default), openrouter or generic.
# PAPERJAM_LLM_PROVIDER=auto
# USD per million tokens for endpoints that report no cost, so that the monthly
# budget works: model=input:output, comma-separated.
# PAPERJAM_LLM_PRICES=
# PAPERJAM_LLM_MODEL=anthropic/claude-haiku-5.5
# PAPERJAM_LLM_VISION_MODEL=anthropic/claude-haiku-5.5
# Second reading of handwritten pages (default on OpenRouter; `off` turns it off).
# PAPERJAM_LLM_HANDWRITING_MODEL=anthropic/claude-sonnet-5.5
# Whitelist of allowed models for reprocessing (comma-separated; defaults to configured models above).
# PAPERJAM_LLM_ALLOWED_MODELS=
# Default `low` on OpenRouter; other endpoints get the field only when set.
# PAPERJAM_LLM_REASONING_EFFORT=
# PAPERJAM_LLM_WORKERS=2
# PAPERJAM_LLM_CREATE_TAGS=true
# PAPERJAM_LLM_MONTHLY_BUDGET_USD=

# Watched inbox folder (off by default). Files dropped here are added and then
# deleted; see "Inbox folder" in the README. The account is needed only when
# more than one user exists; the interval is in seconds.
# PAPERJAM_INBOX_DIR=/inbox
# PAPERJAM_INBOX_USER=
# PAPERJAM_INBOX_INTERVAL_SECS=30

# Upload size limit in bytes (default 100 MiB).
# PAPERJAM_MAX_UPLOAD_BYTES=104857600

# Reverse proxies allowed to name the client address, and the header they use.
# Behind Cloudflare set the header to cf-connecting-ip.
# PAPERJAM_TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12
# PAPERJAM_CLIENT_IP_HEADER=x-forwarded-for

# Days before a due date the calendar feed adds a "renew" event (0 = none).
# PAPERJAM_CALENDAR_LEAD_DAYS=60

# Optional fixed OAuth client for MCP connectors that cannot register themselves.
# All three or none; the secret needs at least 32 bytes; redirect URIs are
# separated by commas or spaces and must match exactly.
# PAPERJAM_OAUTH_STATIC_CLIENT_ID=
# PAPERJAM_OAUTH_STATIC_CLIENT_SECRET=
# PAPERJAM_OAUTH_STATIC_REDIRECT_URIS=

# Read by single commands only, not by the server: PAPERJAM_NEW_PASSWORD
# (`paperjam user add`) and PAPERJAM_TOKEN (`paperjam mcp-stdio`).
